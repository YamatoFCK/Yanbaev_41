<Page x:Class="Yanbaev_41.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Yanbaev_41"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductPage" FontFamily="Comic Sans MS">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0"
                HorizontalAlignment="Right"
                Margin="10">

            <StackPanel Orientation="Horizontal">
                <TextBlock Name="TBlockAuthLabel"
                           Text="Вы вошли как: "/>

                <TextBlock Name="FIOTB"
                           Text="Гость"
                           FontWeight="Bold"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Роль: "/>
                <TextBlock Name="RoleTB"
                           Text="Гость"
                           FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>

        <Button Name="BtnOrder"
                Grid.Row="0"
                Content="Просмотреть заказ"
                Width="200"
                Height="35"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="15,0,0,0"
                Visibility="Collapsed"
                Click="BtnOrder_Click"/>

        <Grid Grid.Row="1" Margin="15,10">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <StackPanel Grid.Row="0"
                Orientation="Horizontal">

                <TextBlock Name="TBlockCount"
                           Text="0 из 0"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0"/>

                <TextBlock Text="Поиск по наименованию:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <TextBox Name="TBoxSearch"
                         Width="200"
                         Height="30"
                         TextChanged="TBoxSearch_TextChanged"/>

            </StackPanel>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="0,10,0,0">

                <StackPanel Margin="0,0,30,0">

                    <RadioButton Name="RButtonUp"
                                 Content="По возрастанию стоимости"
                                 GroupName="Sort"
                                 IsChecked="True"
                                 Checked="Sort_Checked"/>

                    <RadioButton Name="RButtonDown"
                                 Content="По убыванию стоимости"
                                 GroupName="Sort"
                                 Checked="Sort_Checked"/>

                </StackPanel>

                <StackPanel>

                    <TextBlock Text="Фильтрация по скидке"/>

                    <ComboBox Name="ComboType"
                              Width="170"
                              Height="30"
                              SelectedIndex="0"
                              SelectionChanged="ComboType_SelectionChanged">

                        <ComboBoxItem Content="Все диапазоны"/>
                        <ComboBoxItem Content="0-9,99%"/>
                        <ComboBoxItem Content="10-14,99%"/>
                        <ComboBoxItem Content="15% и более"/>

                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Grid>

        <ListView Name="ProductListView"
                  Grid.Row="2"
                  Margin="10">

            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Добавить к заказу"
                              Click="AddToOrder_Click"/>
                </ContextMenu>
            </ListView.ContextMenu>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment"
                            Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <Image Width="110"
                               Height="110"
                               Stretch="Uniform">
                            <Image.Source>
                                <Binding Path="MainImagePath">
                                    <Binding.TargetNullValue>
                                        <ImageSource>/res/picture.png</ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>

                        <StackPanel Grid.Column="1"
                                    Margin="10,0">

                            <TextBlock Text="{Binding ProductName}"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding ProductDescription}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ProductManufacturer}"/>
                            <TextBlock Text="{Binding ProductCost, StringFormat='{}{0:N2} руб.'}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    HorizontalAlignment="Center">

                            <TextBlock Text="Скидка"/>
                            <TextBlock Text="{Binding ProductDiscountAmount, StringFormat='{}{0}%'}"
                                       FontSize="22"
                                       FontWeight="Bold">
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
