<Page x:Class="Yanbaev_41.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Yanbaev_41"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage" FontFamily="Comic Sans MS"
      Loaded="Page_Loaded">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Name="CaptchaPanel"
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">

            <TextBlock Text="Введите код с картинки"
                       HorizontalAlignment="Center"
                       Margin="5"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <TextBlock Name="CaptchaOne"
                           FontSize="25"
                           TextDecorations="Strikethrough"
                           Margin="3,0,3,8"/>

                <TextBlock Name="CaptchaTwo"
                           FontSize="25"
                           TextDecorations="Strikethrough"
                           Margin="3,8,3,0"/>

                <TextBlock Name="CaptchaThree"
                           FontSize="25"
                           TextDecorations="Strikethrough"
                           Margin="3,0,3,5"/>

                <TextBlock Name="CaptchaFour"
                           FontSize="25"
                           TextDecorations="Strikethrough"
                           Margin="3,5,3,0"/>

            </StackPanel>

            <TextBox Name="CaptchaInput"
                     Width="150"
                     Height="30"
                     Margin="5"/>

        </StackPanel>


        <TextBlock Text="Логин"
                   Grid.Row="0"
                   Grid.Column="0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="18"/>

        <TextBox Name="Login"
                 Grid.Row="0"
                 Grid.Column="1"
                 Width="200"
                 Height="30"
                 VerticalAlignment="Center"/>

        <TextBlock Text="Пароль"
                   Grid.Row="1"
                   Grid.Column="0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="18"/>

        <TextBox Name="Pass"
                 Grid.Row="1"
                 Grid.Column="1"
                 Width="200"
                 Height="30"
                 VerticalAlignment="Center"/>

        <Button Content="Войти как гость"
                Name="GuestButton"
                Grid.Row="3"
                Grid.Column="0"
                HorizontalAlignment="Center"
                Click="GuestButton_Click"/>

        <Button Content="Войти"
                Name="LoginButton"
                Grid.Row="3"
                Grid.Column="1"
                HorizontalAlignment="Center"
                Click="LoginButton_Click"/>
    </Grid>
</Page>
