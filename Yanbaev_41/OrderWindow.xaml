<Window x:Class="Yanbaev_41.OrderWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Yanbaev_41"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Оформление заказа"
      Height="550"
      Width="700"
      MinHeight="400"
      MinWidth="550"
      FontFamily="Comic Sans MS">


    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
            HorizontalAlignment="Center"
            Margin="10">

            <TextBlock Text="Ваш заказ"
               FontSize="24"
               FontWeight="Bold"
               HorizontalAlignment="Center"/>

            <TextBlock Name="TBlockClient"
               FontSize="16"
               Visibility="Collapsed"
               HorizontalAlignment="Center"/>
        </StackPanel>

        <ListView Name="OrderListView"
                  Grid.Row="1">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment"
                        Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <Image Width="100"
                           Height="100"
                           Stretch="Uniform">
                            <Image.Source>
                                <Binding Path="Product.MainImagePath">
                                    <Binding.TargetNullValue>
                                        <ImageSource>/res/picture.png</ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>

                        <StackPanel Grid.Column="1"
                                    Margin="10,0">

                            <TextBlock Text="{Binding Product.ProductName}"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding Product.ProductDescription}"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="{Binding Product.ProductCost,
                                       StringFormat='{}{0:N2} руб.'}"/>

                        </StackPanel>


                        <StackPanel Grid.Column="2"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="Количество:"
                                       HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">

                                <Button Content="-"
                                        Name="RemoveQuantity"
                                        Width="30"
                                        Height="30"
                                        FontSize="16"
                                        Margin="3"
                                        Click="RemoveQuantity_Click"/>

                                <TextBlock Text="{Binding Quantity}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="5,0"/>

                                <Button Content="+"
                                        Name="AddQuantity"
                                        Width="30"
                                        Height="30"
                                        FontSize="16"
                                        Margin="3"
                                        Click="AddQuantity_Click"/>
                            </StackPanel>
                        </StackPanel>

                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Left"
                    Margin="390,10,0,10" Width="380">

            <TextBlock Text="Пункт выдачи:"
                       FontSize="16"
                       Margin="0,10,0,5"/>

            <ComboBox Name="ComboPickupPoint"
                      Width="300"
                      Height="30"
                      DisplayMemberPath="Address"
                      SelectedValuePath="PickupID"
                      Margin="0,0,0,15"/>


            <TextBlock Name="TBlockTotal"
                       Text="Сумма без скидки: 0 руб."
                       FontSize="16"/>

            <TextBlock Name="TBlockDiscount"
                       Text="Скидка: 0 руб."
                       FontSize="16"/>

            <TextBlock Name="TBlockFinal"
                       Text="Итого: 0 руб."
                       FontSize="20"
                       FontWeight="Bold"/>

            <Button Name="BtnSaveOrder"
                    Content="Оформить заказ"
                    Width="200"
                    Height="35"
                    Margin="0,15,0,0"
                    Click="BtnSaveOrder_Click"/>


        </StackPanel>

    </Grid>
</Window>
